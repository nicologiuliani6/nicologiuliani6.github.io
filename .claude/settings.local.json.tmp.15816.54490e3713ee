{
  "permissions": {
    "allow": [
      "Bash(python3 -m http.server 8000)",
      "Bash(curl -s -o /dev/null -w \"index.html %{http_code}\\\\n\" http://localhost:8000/)",
      "Bash(curl -s -o /dev/null -w \"style.css  %{http_code}\\\\n\" http://localhost:8000/assets/style.css)",
      "Bash(curl -s -o /dev/null -w \"blog/      %{http_code}\\\\n\" http://localhost:8000/blog/)",
      "Bash(curl -s -o /dev/null -w \"post/      %{http_code}\\\\n\" http://localhost:8000/blog/cavium-cn6640-bar2-datapath/)",
      "Bash(curl -s -o /dev/null -w \"home %{http_code}\\\\n\" http://localhost:8000/)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
