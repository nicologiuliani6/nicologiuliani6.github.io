// Factorisation, from the report by Lutz and Derby (1982), translated to Kairos.
// num ends at zero; fact holds the factors in increasing order from fact[1].
// `try` is a reserved word in Kairos, so the variable is called t.

procedure nexttry(int t)
    t += 2
    if   t == 4
    then t -= 1
    fi   t == 3

procedure zeroi(int fact[], int i)
    from fact[i + 1] == 0
    loop i -= 1
    until i == 0

procedure factor(int num, int t, int z, int i, int fact[])
    from (t == 0) && (num > 1)
    loop call nexttry(t)
         from fact[i] != t          // divide out every occurrence of the factor
         loop i += 1
              fact[i] += t
              z += num / t
              z <=> num
              z -= num * t
         until (num % t) != 0
    until (t * t) > num             // exit as early as possible

    if   num != 1
    then i += 1                     // the last prime goes into the table
         fact[i] <=> num            // and num goes to zero
    else num -= 1
    fi   fact[i] != fact[i - 1]

    if   (fact[i - 1] * fact[i - 1]) < fact[i]      // zero t
    then from (t * t) > fact[i]
         loop uncall nexttry(t)
         until t == 0
    else t -= fact[i - 1]
    fi   (fact[i - 1] * fact[i - 1]) < fact[i]

    call zeroi(fact, i)

procedure main()
    local int num = 0
    local int t = 0
    local int z = 0
    local int i = 0
    local int fact[20] = 0
    num += 840
    call factor(num, t, z, i, fact)
    show(num)
    show(fact)
    uncall factor(num, t, z, i, fact)
    show(num)
    num -= 840
    delocal int fact[20] = 0
    delocal int i = 0
    delocal int z = 0
    delocal int t = 0
    delocal int num = 0
