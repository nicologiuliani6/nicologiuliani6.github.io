// Mnemo pointer pool: cells < 8 in the __mn_mem array, the others on the tape.
procedure __mn_pool_alloc(int ctr, int out_slot, int nblk, stack __mn_hist, stack __mn_scratch)
    push(out_slot, __mn_hist)
    out_slot += ctr
    out_slot += 1
    ctr += nblk
    ctr += 1

procedure __mn_pool_free(int slot, int ctr, int nblk, stack __mn_hist, stack __mn_scratch)
    local int ctr0 = 0
        ctr0 += ctr
    local int last = 0
        last += slot
        last += nblk
        if ctr0 == last then
            ctr -= nblk
            ctr -= 1
        fi ctr0 == last
        push(last, __mn_hist)
    delocal int last = 0
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

// Tape cursor on r (0 <= r <= tn): cells 0..r-1 in tl, cell r on top of tr.
procedure __mn_tape_move(int r, stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    local int dr = 0
    dr += ((r - __mn_tc) * ((r - __mn_tc) > 0))
    local int dl = 0
    dl += ((__mn_tc - r) * ((__mn_tc - r) > 0))
    if dr != 0 then
        local int k = 0
        from k == 0 do
            local int v = 0
            pop(v, __mn_tr)
            push(v, __mn_tl)
            delocal int v = 0
            k += 1
        loop until k == dr
        delocal int k = dr
        __mn_tc += dr
    fi dr != 0
    if dl != 0 then
        local int k = 0
        from k == 0 do
            local int v = 0
            pop(v, __mn_tl)
            push(v, __mn_tr)
            delocal int v = 0
            k += 1
        loop until k == dl
        delocal int k = dl
        __mn_tc -= dl
    fi dl != 0
    push(dl, __mn_hist)
    delocal int dl = 0
    push(dr, __mn_hist)
    delocal int dr = 0

// Grow the tape with zero cells until it contains cell r (tn > r).
procedure __mn_tape_reach(int r, stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    local int e = 0
    e += (((r + 1) - __mn_tn) * (((r + 1) - __mn_tn) > 0))
    if e != 0 then
        local int n = 0
        n += __mn_tn
        call __mn_tape_move(n, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        n -= __mn_tn
        delocal int n = 0
        local int k = 0
        from k == 0 do
            local int z = 0
            push(z, __mn_tl)
            delocal int z = 0
            __mn_tc += 1
            __mn_tn += 1
            k += 1
        loop until k == e
        delocal int k = e
    fi e != 0
    push(e, __mn_hist)
    delocal int e = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem[], stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    if slot < 8 then
        local int t = 0
            t += __mn_mem[slot]
            __mn_mem[slot] -= t
            push(t, __mn_hist)
        delocal int t = 0
        __mn_mem[slot] += val
    else
        local int r = 0
        r += (slot - 8)
        call __mn_tape_reach(r, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        call __mn_tape_move(r, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        local int v = 0
        pop(v, __mn_tr)
        push(v, __mn_hist)
        v += val
        push(v, __mn_tr)
        delocal int v = 0
        r -= (slot - 8)
        delocal int r = 0
    fi slot < 8

procedure __mn_pool_load(int slot, int __mn_mem[], int out, stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    if slot < 8 then
        local int t = 0
            t += __mn_mem[slot]
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    else
        local int r = 0
        r += (slot - 8)
        call __mn_tape_reach(r, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        call __mn_tape_move(r, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        local int v = 0
        pop(v, __mn_tr)
        push(out, __mn_hist)
        out += v
        push(v, __mn_tr)
        delocal int v = 0
        r -= (slot - 8)
        delocal int r = 0
    fi slot < 8

procedure add_weight(int __mn_mem[], stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    local int __mn_pool_ctr = 0
    local int __mn_e0 = 0
    local int __mn_e1 = 0
    local int __mn_e2 = 0
    local int __mn_e3 = 0
        // C function add_weight
        push(__mn_e1, __mn_hist)
        __mn_e1 += __mn_mem[1]
        call __mn_pool_load(__mn_e1, __mn_mem, __mn_e0, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        __mn_e2 += __mn_e0
        __mn_e2 += __mn_mem[2]
        push(__mn_e3, __mn_hist)
