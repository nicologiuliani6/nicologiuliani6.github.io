// Sposta il valore di src in dst (src azzerato) usando uno stack locale come "garbage" / condotto.
// La VM implementa `pop(dst, …)` come `*dst += valore`: per sostituire dst, azzeralo prima con
// `push(dst, hist)` sullo stack Janus del caller, poi `call __mn_move_int(dst, src)`.
procedure __mn_move_int(int dst, int src, stack __mn_hist, stack __mn_scratch)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

// Mask x a 32 bit bassi: x = x & 0xFFFFFFFF (unsigned: il resto è sempre in
// [0, 2^32), anche per x negativo). Il valore originale va su __mn_hist.
procedure __mn_mask_u32(int x, stack __mn_hist, stack __mn_scratch)
    local int lo = 0
    lo += (((x % 4294967296) + 4294967296) % 4294967296)
    x <=> lo
    push(lo, __mn_hist)
    delocal int lo = 0

// Prodotto: dst += a * b (`*` nativo nelle espressioni Kairos). a e b inalterati.
procedure __mn_mul_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    dst += (a * b)

// Come __mn_mul_into, b di segno qualsiasi.
procedure __mn_mul_signed_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    dst += (a * b)

// Divisione e resto con `/` e `%` nativi di Kairos: semantica C99 (troncamento
// verso zero, resto col segno del dividendo). q = 0 e r = 0 all'ingresso, b != 0.

// Uscita: q = a/b, r = a%b, a = 0 (il dividendo è consumato).
procedure __mn_divmod_nonneg(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    q += (a / b)
    r += (a % b)
    a -= ((q * b) + r)

// Uscita: q = a/b, r = a%b, a e b inalterati.
procedure __mn_divmod_signed(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    q += (a / b)
    r += (a % b)

// Uscita: q = a/b, r = a%b, a e b inalterati.
procedure __mn_divmod_nonneg_fast(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    q += (a / b)
    r += (a % b)

// Uscita: r = a%b, a e b inalterati.
procedure __mn_mod_signed(int a, int b, int r, stack __mn_hist, stack __mn_scratch)
    r += (a % b)

// Operazioni bitwise sugli interi di Kairos (Kairos non ha & | << >>).
// Tutto con `* / %` e confronti nativi nelle espressioni. Convenzione: gli
// *_into fanno dst += f(...); gli altri argomenti restano inalterati salvo
// dove indicato. Gli scarti intermedi vanno su __mn_hist.
//
// Bit k di x (shift aritmetico, come in C):  floor(x / 2^k) mod 2, con
//   floor(x / p) = (x / p) - ((x % p) < 0)   e   m mod 2 = ((m % 2) + 2) % 2

// dst += 2^n, n >= 0.
procedure __mn_pow2_into(int dst, int n, stack __mn_hist, stack __mn_scratch)
    local int p = 1
    local int i = 0
    if n != 0 then
        from i == 0 do
            local int np = 0
            np += (p * 2)
            p <=> np
            push(np, __mn_hist)
            delocal int np = 0
            i += 1
        loop until i == n
    fi n != 0
    dst += p
    push(p, __mn_hist)
    delocal int i = n
    delocal int p = 0

// q += a / 2, r += a % 2 (a >= 0, q = r = 0 all'ingresso); a = 0.
procedure __mn_divmod_nonneg_div2(int a, int q, int r, stack __mn_hist, stack __mn_scratch)
    q += (a / 2)
    r += (a % 2)
    a -= ((q * 2) + r)

// q += floor(t / 2) (q = 0 all'ingresso); t = 0.
procedure __mn_floor_div2_signed(int t, int q, stack __mn_hist, stack __mn_scratch)
    q += ((t / 2) - ((t % 2) < 0))
    local int r = 0
    r += (t - (q * 2))
    t -= ((q * 2) + r)
    push(r, __mn_hist)
    delocal int r = 0

// bit_out += bit kk di a (shift aritmetico).
procedure __mn_bit_k_signed(int a, int kk, int bit_out, stack __mn_hist, stack __mn_scratch)
    local int p = 0
    call __mn_pow2_into(p, kk, __mn_hist, __mn_scratch)
    bit_out += (((((a / p) - ((a % p) < 0)) % 2) + 2) % 2)
    uncall __mn_pow2_into(p, kk, __mn_hist, __mn_scratch)
    delocal int p = 0

// dst += (a & b) su 32 bit con segno: bit 0..30 col loro peso, bit 31 con
// peso -2^31 (complemento a 2 di un int C).
procedure __mn_and_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    from k == 0 do
        dst += ((((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2) * (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2) * pow)
        local int np = 0
        np += (pow * 2)
        pow <=> np
        push(np, __mn_hist)
        delocal int np = 0
        k += 1
    loop until k == 31
    dst -= ((((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2) * (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2) * pow)
    push(pow, __mn_hist)
    delocal int pow = 0
    delocal int k = 31

// dst += (a | b), stessa convenzione di __mn_and_into: bit = ba + bb - ba*bb.
procedure __mn_or_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    local int ba = 0
    local int bb = 0
    from k == 0 do
        ba += (((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2)
        bb += (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2)
        dst += (((ba + bb) - (ba * bb)) * pow)
        push(bb, __mn_hist)
        push(ba, __mn_hist)
        local int np = 0
        np += (pow * 2)
        pow <=> np
        push(np, __mn_hist)
        delocal int np = 0
        k += 1
    loop until k == 31
    ba += (((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2)
    bb += (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2)
    dst -= (((ba + bb) - (ba * bb)) * pow)
    push(bb, __mn_hist)
    push(ba, __mn_hist)
    delocal int bb = 0
    delocal int ba = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    delocal int k = 31

// dst += (a & b) su 64 bit (long long / uint64_t): bit 0..62 col loro peso,
// bit 63 (il segno) con peso -2^63, sommato come due volte -2^62.
procedure __mn_and64_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    from k == 0 do
        dst += ((((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2) * (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2) * pow)
        local int np = 0
        np += (pow * 2)
        pow <=> np
        push(np, __mn_hist)
        delocal int np = 0
        k += 1
    loop until k == 62
    dst += ((((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2) * (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2) * pow)
    dst -= ((a < 0) * (b < 0) * pow)
    dst -= ((a < 0) * (b < 0) * pow)
    push(pow, __mn_hist)
    delocal int pow = 0
    delocal int k = 62

// dst += (a | b) su 64 bit, stessa convenzione di __mn_and64_into.
procedure __mn_or64_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    local int ba = 0
    local int bb = 0
    from k == 0 do
        ba += (((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2)
        bb += (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2)
        dst += (((ba + bb) - (ba * bb)) * pow)
        push(bb, __mn_hist)
        push(ba, __mn_hist)
        local int np = 0
        np += (pow * 2)
        pow <=> np
        push(np, __mn_hist)
        delocal int np = 0
        k += 1
    loop until k == 62
    ba += (((((a / pow) - ((a % pow) < 0)) % 2) + 2) % 2)
    bb += (((((b / pow) - ((b % pow) < 0)) % 2) + 2) % 2)
    dst += (((ba + bb) - (ba * bb)) * pow)
    push(bb, __mn_hist)
    push(ba, __mn_hist)
    ba += (a < 0)
    bb += (b < 0)
    dst -= (((ba + bb) - (ba * bb)) * pow)
    dst -= (((ba + bb) - (ba * bb)) * pow)
    push(bb, __mn_hist)
    push(ba, __mn_hist)
    delocal int bb = 0
    delocal int ba = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    delocal int k = 62

// dst += (x << n), n >= 0.
procedure __mn_shl_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int p = 0
    call __mn_pow2_into(p, n, __mn_hist, __mn_scratch)
    dst += (x * p)
    uncall __mn_pow2_into(p, n, __mn_hist, __mn_scratch)
    delocal int p = 0

// Dimezzamento UNSIGNED a 64 bit: q += x_u / 2, r += x_u % 2 dove x_u è x letto
// come unsigned (x + 2^64 se x < 0); x = 0. Per x < 0: floor(x/2) + 2^63, che
// si somma come (2^63 - 1) + 1 su un valore negativo, senza traboccare.
procedure __mn_uhalve64(int x, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int f = 0
    local int b = 0
    local int neg = 0
    f += ((x / 2) - ((x % 2) < 0))
    b += (((x % 2) + 2) % 2)
    neg += (x < 0)
    x -= ((f * 2) + b)
    q += f
    if neg != 0 then
        q += 9223372036854775807
        q += 1
    fi neg != 0
    r += b
    push(neg, __mn_hist)
    delocal int neg = 0
    push(b, __mn_hist)
    delocal int b = 0
    push(f, __mn_hist)
    delocal int f = 0

// dst += (x >> n) logico (unsigned, 64 bit): il primo dimezzamento unsigned
// rende il valore non negativo, gli altri sono divisioni per 2.
procedure __mn_shr_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += x
    local int i = 0
    if n != 0 then
        from i == 0 do
            i += 1
            local int qh = 0
            local int ph = 0
            call __mn_uhalve64(t, qh, ph, __mn_hist, __mn_scratch)
            t += qh
            push(ph, __mn_hist)
            delocal int ph = 0
            push(qh, __mn_hist)
            delocal int qh = 0
        loop until i == n
    fi n != 0
    dst += t
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

// Stampa intero con segno (show byte, char). Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE: usa `uncall __mn_divmod_nonneg` per ripristinare n e azzerare qu/rem.
// Permette `call __mn_putd_uint; uncall __mn_putd_uint` (show è no-op in inverse).

procedure __mn_putd_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

// Variante fast: usa __mn_divmod_nonneg_fast (sub-lineare via mnhalve VM)
// invece di __mn_divmod_nonneg (lineare O(n/10)). Necessario per n grandi
// (es. %u runtime negative dove n può essere fino a 2^32-1).
procedure __mn_putd_uint_fast(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint_fast(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

procedure __mn_putd(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
        local int t = 0
        t -= n
        n += t
        n <=> t
        delocal int t = 0
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
        local int t2 = 0
        t2 -= n
        n += t2
        n <=> t2
        delocal int t2 = 0
    else
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    fi n < z
    delocal int z = 0

// `%+d` runtime: prepend `+` se n>=0, poi __mn_putd.
procedure __mn_putd_plus(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int p = 0
        p += 43
        show(p, char)
        p -= 43
        delocal int p = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// `% d` runtime: prepend ` ` se n>=0, poi __mn_putd.
procedure __mn_putd_space(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int sp = 0
        sp += 32
        show(sp, char)
        sp -= 32
        delocal int sp = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// Conta le cifre decimali di un n >= 0 (inclusivo: n=0 conta 1).
// d += digits(n). Reversibile: n e ten immutati nel body.
procedure __mn_dcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int q = 0
    local int r = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
        call __mn_dcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= ten
    ten -= 10
    delocal int r = 0
    delocal int q = 0
    delocal int ten = 0

// Emette `count` spazi (codice 32). count immutato (loop counter su local rem).
procedure __mn_emit_spaces(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count do
            local int sp = 0
            sp += 32
            show(sp, char)
            sp -= 32
            delocal int sp = 0
            rem -= 1
        loop until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// Emette `count` zeri ASCII (codice 48). count immutato.
procedure __mn_emit_zeros(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count do
            local int zc = 0
            zc += 48
            show(zc, char)
            zc -= 48
            delocal int zc = 0
            rem -= 1
        loop until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// `%-Nd` runtime: emette `__mn_putd(n)` poi `(N - digits_of(n)) - (1 se n<0)`
// spazi a destra. Stesso schema di __mn_putd_width ma ordine show invertito.
procedure __mn_putd_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    call __mn_putd(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    uncall __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%0Nd` runtime: se n<0 emette `-`, poi `(N - 1 - digits)` zeri, poi
// __mn_putd_uint(abs_n). Se n>=0 emette `(N - digits)` zeri poi __mn_putd_uint(n).
procedure __mn_putd_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
    fi n < z
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(abs_n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    uncall __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%Nu` runtime: emette (N - digits) spazi a sinistra, poi __mn_putd_uint(n).
procedure __mn_putd_uint_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

procedure __mn_putd_uint_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

procedure __mn_putd_uint_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// `%Nd` runtime: emette `(N - digits_of(n)) - (1 se n<0)` spazi a sinistra,
// poi `__mn_putd(n)`. N può essere <= digits → nessun padding.
procedure __mn_putd_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    uncall __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// Stampa intero non negativo in esadecimale minuscolo.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_putx_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putx_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putx(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_putx_uint(n, __mn_hist, __mn_scratch)

// Conta le cifre esadecimali di un n >= 0 (n=0 conta 1).
// d += hex_digits(n). Reversibile via uncall divmod_nonneg.
procedure __mn_hcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int q = 0
    local int r = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, q, r, __mn_hist, __mn_scratch)
        call __mn_hcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, base, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= base
    base -= 16
    delocal int r = 0
    delocal int q = 0
    delocal int base = 0

// `%Nx` runtime: emette (N - hex_digits(n)) spazi a sinistra, poi __mn_putx.
procedure __mn_putx_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putx(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// `%-Nx` runtime: __mn_putx poi (N - hex_digits) spazi a destra.
procedure __mn_putx_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_putx(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// `%0Nx` runtime: emette (N - hex_digits) zeri ASCII, poi __mn_putx.
procedure __mn_putx_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putx(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// Split u64 hi/lo (bit 32-63 / 0-31) di un cell a 64 bit, puro (nessun
// opcode nativo — era MNSPLIT32 O(1) host C, ora __mn_divmod_nonneg_fast
// contro 2^32, O(32) iterazioni via raddoppio puro). Forward azzera src
// (consumato, come il contratto nativo originale); inverse (uncall)
// ripristina src e azzera hi/lo.
// x >= 0: divmod diretta contro 2^32. x < 0 (high bit set = valore unsigned
// grande in complemento a 2, x_u = x + 2^64): ab = |x| (negazione sicura
// salvo x == INT64_MIN, caso limite gestito a parte — stessa cautela di
// __mn_uhalve64 in bits.kairos), qab = ab/2^32, rab = ab%2^32:
//   lo = (rab==0) ? 0 : (2^32 - rab);  hi = 2^32 - qab - (rab==0 ? 0 : 1)
// (qui il modulo è 2^32, non 2^63: hi resta sempre < 2^32, ben dentro il
// range int64 positivo — nessun accorgimento extra per overflow intermedi,
// a differenza di __mn_uhalve64).
procedure __mn_u64_split32(int src, int hi, int lo, stack __mn_hist, stack __mn_scratch)
    local int xorig = 0
    xorig += src
    local int mod32 = 1
    local int i = 0
    from i == 0 do
        local int m2 = 0
        m2 += mod32
        m2 += mod32
        push(mod32, __mn_hist)
        call __mn_move_int(mod32, m2, __mn_hist, __mn_scratch)
        push(m2, __mn_hist)
        delocal int m2 = 0
        i += 1
    loop until i == 32
    local int min64 = 0
    min64 -= 1
    local int j = 0
    from j == 0 do
        local int m2b = 0
        m2b += min64
        m2b += min64
        push(min64, __mn_hist)
        call __mn_move_int(min64, m2b, __mn_hist, __mn_scratch)
        push(m2b, __mn_hist)
        delocal int m2b = 0
        j += 1
    loop until j == 63
    local int is_min = 0
    if xorig == min64 then
        is_min += 1
    fi xorig == min64
    if is_min == 1 then
        // src = INT64_MIN: x_u = 2^63 esatto. hi = 2^31, lo = 0.
        local int p31 = 1
        local int k = 0
        from k == 0 do
            local int p2 = 0
            p2 += p31
            p2 += p31
            push(p31, __mn_hist)
            call __mn_move_int(p31, p2, __mn_hist, __mn_scratch)
            push(p2, __mn_hist)
            delocal int p2 = 0
            k += 1
        loop until k == 31
        hi += p31
        push(k, __mn_hist)
        delocal int k = 0
        push(p31, __mn_hist)
        delocal int p31 = 0
    else
        local int neg = 0
        if xorig < 0 then
            neg += 1
        fi xorig < 0
        local int ab = 0
        if neg == 1 then
            ab -= xorig
        else
            ab += xorig
        fi neg == 1
        local int qab = 0
        local int rab = 0
        call __mn_divmod_nonneg_fast(ab, mod32, qab, rab, __mn_hist, __mn_scratch)
        if neg == 1 then
            local int rz = 0
            if rab == 0 then
                rz += 1
            fi rab == 0
            if rz == 0 then
                lo += mod32
                lo -= rab
                hi += mod32
                hi -= qab
                hi -= 1
            else
                hi += mod32
                hi -= qab
            fi rz == 0
            push(rz, __mn_hist)
            delocal int rz = 0
        else
            lo += rab
            hi += qab
        fi neg == 1
        uncall __mn_divmod_nonneg_fast(ab, mod32, qab, rab, __mn_hist, __mn_scratch)
        delocal int rab = 0
        delocal int qab = 0
        if neg == 1 then
            ab += xorig
        else
            ab -= xorig
        fi neg == 1
        delocal int ab = 0
        push(neg, __mn_hist)
        delocal int neg = 0
    fi is_min == 1
    push(is_min, __mn_hist)
    delocal int is_min = 0
    // Consuma src (mnsplit32 lo azzerava nativamente).
    local int sink = 0
    call __mn_move_int(sink, src, __mn_hist, __mn_scratch)
    push(sink, __mn_hist)
    delocal int sink = 0
    push(j, __mn_hist)
    delocal int j = 0
    push(min64, __mn_hist)
    delocal int min64 = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(mod32, __mn_hist)
    delocal int mod32 = 0
    push(xorig, __mn_hist)
    delocal int xorig = 0

// Stampa intero u64 in esadecimale lowercase, no leading zeros.
// Per cell >= 2^32 oppure cell < 0 (high bit set in signed int64), serve
// gestione esplicita: __mn_putx_uint riceve solo nonneg fino a ~2^31.
// Split: hi = bits 32-63 (u64), lo = bits 0-31. Se hi==0, print lo. Else
// print hi poi lo padded a 8 cifre.
procedure __mn_putx_u64(int n, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    call __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    local int z = 0
    if hi > z then
        call __mn_putx_uint(hi, __mn_hist, __mn_scratch)
        local int eight = 0
        eight += 8
        call __mn_putx_width_zero(lo, eight, __mn_hist, __mn_scratch)
        eight -= 8
        delocal int eight = 0
    else
        call __mn_putx_uint(lo, __mn_hist, __mn_scratch)
    fi hi > z
    delocal int z = 0
    uncall __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    delocal int lo = 0
    delocal int hi = 0

// ===== Variante UPPERCASE (%X / %llX): identica a putx ma cifre A-F (+55). =====
procedure __mn_putX_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putX_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 55
            show(ch, char)
            ch -= 55
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 55
            show(ch, char)
            ch -= 55
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putX(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_putX_uint(n, __mn_hist, __mn_scratch)

// `%0NX` uppercase: (N - hex_digits) zeri poi __mn_putX.
procedure __mn_putX_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putX(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// `%NX` uppercase: (N - hex_digits) spazi poi __mn_putX.
procedure __mn_putX_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putX(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// u64 uppercase no leading zeros.
procedure __mn_putX_u64(int n, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    call __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    local int z = 0
    if hi > z then
        call __mn_putX_uint(hi, __mn_hist, __mn_scratch)
        local int eight = 0
        eight += 8
        call __mn_putX_width_zero(lo, eight, __mn_hist, __mn_scratch)
        eight -= 8
        delocal int eight = 0
    else
        call __mn_putX_uint(lo, __mn_hist, __mn_scratch)
    fi hi > z
    delocal int z = 0
    uncall __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    delocal int lo = 0
    delocal int hi = 0

// `%0WllX` u64 uppercase zero-pad a W (W>=16: hi(8)+lo(8), + (W-16) zeri).
procedure __mn_putX_u64_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    call __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    local int sixteen = 0
    sixteen += 16
    local int extra = 0
    extra += width
    extra -= sixteen
    local int zp = 0
    if extra > zp then
        call __mn_emit_zeros(extra, __mn_hist, __mn_scratch)
    fi extra > zp
    extra -= width
    extra += sixteen
    delocal int zp = 0
    delocal int extra = 0
    sixteen -= 16
    delocal int sixteen = 0
    local int eight = 0
    eight += 8
    call __mn_putX_width_zero(hi, eight, __mn_hist, __mn_scratch)
    call __mn_putX_width_zero(lo, eight, __mn_hist, __mn_scratch)
    eight -= 8
    delocal int eight = 0
    uncall __mn_u64_split32(n, hi, lo, __mn_hist, __mn_scratch)
    delocal int lo = 0
    delocal int hi = 0

// Stampa intero non negativo in ottale.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_puto_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 8
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_puto_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= base
    base -= 8
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_puto(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_puto_uint(n, __mn_hist, __mn_scratch)

// Conta le cifre ottali di n >= 0 (n=0 conta 1).
procedure __mn_ocount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 8
    local int q = 0
    local int r = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, q, r, __mn_hist, __mn_scratch)
        call __mn_ocount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg(n, base, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= base
    base -= 8
    delocal int r = 0
    delocal int q = 0
    delocal int base = 0

procedure __mn_puto_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_puto(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

procedure __mn_puto_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_puto(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

procedure __mn_puto_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_puto(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    uncall __mn_ocount_unsigned(n, d, __mn_hist, __mn_scratch)
    delocal int d = 0

// Mnemo pointer pool: cells < 294 in the __mn_mem array, the others on the tape.
procedure __mn_pool_alloc(int ctr, int out_slot, int nblk, stack __mn_hist, stack __mn_scratch)
    push(out_slot, __mn_hist)
    out_slot += ctr
    out_slot += 1
    ctr += nblk
    ctr += 1

procedure __mn_pool_free(int slot, int ctr, int nblk, stack __mn_hist, stack __mn_scratch)
    local int ctr0 = 0
        ctr0 += ctr
    local int last = 0
        last += slot
        last += nblk
        if ctr0 == last then
            ctr -= nblk
            ctr -= 1
        fi ctr0 == last
        push(last, __mn_hist)
    delocal int last = 0
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

// Tape cursor on r (0 <= r <= tn): cells 0..r-1 in tl, cell r on top of tr.
procedure __mn_tape_move(int r, stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    local int dr = 0
    dr += ((r - __mn_tc) * ((r - __mn_tc) > 0))
    local int dl = 0
    dl += ((__mn_tc - r) * ((__mn_tc - r) > 0))
    if dr != 0 then
        local int k = 0
        from k == 0 do
            local int v = 0
            pop(v, __mn_tr)
            push(v, __mn_tl)
            delocal int v = 0
            k += 1
        loop until k == dr
        delocal int k = dr
        __mn_tc += dr
    fi dr != 0
    if dl != 0 then
        local int k = 0
        from k == 0 do
            local int v = 0
            pop(v, __mn_tl)
            push(v, __mn_tr)
            delocal int v = 0
            k += 1
        loop until k == dl
        delocal int k = dl
        __mn_tc -= dl
    fi dl != 0
    push(dl, __mn_hist)
    delocal int dl = 0
    push(dr, __mn_hist)
    delocal int dr = 0

// Grow the tape with zero cells until it contains cell r (tn > r).
procedure __mn_tape_reach(int r, stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    local int e = 0
    e += (((r + 1) - __mn_tn) * (((r + 1) - __mn_tn) > 0))
    if e != 0 then
        local int n = 0
        n += __mn_tn
        call __mn_tape_move(n, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        n -= __mn_tn
        delocal int n = 0
        local int k = 0
        from k == 0 do
            local int z = 0
            push(z, __mn_tl)
            delocal int z = 0
            __mn_tc += 1
            __mn_tn += 1
            k += 1
        loop until k == e
        delocal int k = e
    fi e != 0
    push(e, __mn_hist)
    delocal int e = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem[], stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    if slot < 294 then
        local int t = 0
            t += __mn_mem[slot]
            __mn_mem[slot] -= t
            push(t, __mn_hist)
        delocal int t = 0
        __mn_mem[slot] += val
    else
        local int r = 0
        r += (slot - 294)
        call __mn_tape_reach(r, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        call __mn_tape_move(r, __mn_tl, __mn_tr, __mn_tc, __mn_tn, __mn_hist, __mn_scratch)
        local int v = 0
        pop(v, __mn_tr)
        push(v, __mn_hist)
        v += val
        push(v, __mn_tr)
        delocal int v = 0
        r -= (slot - 294)
        delocal int r = 0
    fi slot < 294

procedure __mn_pool_load(int slot, int __mn_mem[], int out, stack __mn_tl, stack __mn_tr, int __mn_tc, int __mn_tn, stack __mn_hist, stack __mn_scratch)
    if slot < 294 then
        local int t = 0
            t += __mn_mem[slot]
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    else
        local int r = 0
